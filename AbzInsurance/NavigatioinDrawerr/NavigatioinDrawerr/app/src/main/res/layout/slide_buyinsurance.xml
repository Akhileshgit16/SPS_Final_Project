<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="#D6CBDC"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        android:elevation="5dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="#7066A4"
            android:padding="16dp">

            <!-- CardView around ImageView with rounded corners -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="5dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#433A7C"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:id="@+id/buyInsuranceImage"
                    android:layout_width="wrap_content"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/carbuyinsurance"
                    android:contentDescription="TODO"/>


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/titleBuyInsurance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/buy_insurance_title"
                android:textColor="@color/purple2"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subTitleBuyInsurance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy_insurance_subtitle"
                android:textSize="20sp"
                android:textColor="@color/magneta"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <TextView
                android:id="@+id/instructionBuyInsurance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy_insurance_instruction"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
